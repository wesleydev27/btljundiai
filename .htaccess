# ─────────────────────────────────────────────
#  FM Assistência Técnica – .htaccess
#  Segurança, SEO, Performance – Hostinger
# ─────────────────────────────────────────────

Options -Indexes
ServerSignature Off

# ── HTTPS forçado (desativado em localhost) ──
RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── WWW → sem www (escolha um padrão) ──
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── URLs limpas para API (opcional) ──
RewriteRule ^api/([a-z_]+)/?$ api/$1.php [L,QSA]

# ── Bloquear acesso direto a arquivos PHP da API via browser ──
RewriteCond %{THE_REQUEST} /api/(config)\.php [NC]
RewriteRule ^ - [F,L]

# ── Bloquear leitura de arquivos sensíveis ──
<FilesMatch "(config\.php|\.env|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Proteção do painel admin por IP (descomente e ajuste) ──
# <Directory "admin">
#     Order Deny,Allow
#     Deny from all
#     Allow from 177.x.x.x  # seu IP fixo
# </Directory>

# ── Cache de assets estáticos ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg            "access plus 1 year"
    ExpiresByType image/jpeg           "access plus 1 year"
    ExpiresByType image/png            "access plus 1 year"
    ExpiresByType image/webp           "access plus 1 year"
    ExpiresByType image/svg+xml        "access plus 1 month"
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-font-woff2 "access plus 1 year"
</IfModule>

# ── Compressão GZIP ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Segurança Headers ──
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS (ative só após confirmar que HTTPS funciona)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Página de erro customizada ──
ErrorDocument 404 /404.html
ErrorDocument 403 /index.html
